{
  "name": "homemusic-desktop",
  "version": "1.3.1",
  "private": true,
  "description": "HomeMusic — музыкальный клиент для Windows",
  "author": "HomeMusic",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ru.llirkit.homemusic.desktop",
    "productName": "HomeMusic",
    "artifactName": "HomeMusic-Setup-${version}.${ext}",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "extraResources": [
      { "from": "../web/public/icons/icon-512.png", "to": "icon.png" }
    ],
    "win": { "icon": "../web/public/icons/icon-512.png", "target": "nsis" },
    "publish": [{ "provider": "generic", "url": "https://updates.invalid/desktop/updates/windows/x64/" }],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerLanguages": ["ru_RU"],
      "language": "1049"
    }
  }
}
